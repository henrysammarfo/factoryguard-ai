# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# supOS CE Configuration
SUPOS_BASE_URL=http://localhost:1880
SUPOS_USERNAME=admin
SUPOS_PASSWORD=your_supos_password_here

# MQTT Configuration (HiveMQ Cloud or local broker)
MQTT_BROKER_URL=your_mqtt_broker_url_here
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username_here
MQTT_PASSWORD=your_mqtt_password_here
MQTT_USE_TLS=true

# Hugging Face AI Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development