    {
        "id": "equipment-db-write",
        "type": "function",
        "z": "factoryguard-sourceflow",
        "name": "Format for DB",
        "func": "// Format equipment data for database\nmsg.payload = {\n    equipment_id: msg.payload.id,\n    name: msg.payload.name,\n    type: msg.payload.type,\n    status: msg.payload.status,\n    health_score: msg.payload.health_score,\n    location: msg.payload.location,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "db-equipment-insert"
            ]
        ]
    },
    {
        "id": "sensor-db-write",
        "type": "function",
        "z": "factoryguard-sourceflow",
        "name": "Format for TSDB",
        "func": "// Format sensor data for TimescaleDB\nmsg.payload = {\n    equipment_id: msg.payload.equipment_id,\n    sensor_type: msg.payload.sensor_type,\n    value: msg.payload.value,\n    unit: msg.payload.unit,\n    timestamp: msg.payload.timestamp || new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 200,
        "wires": [
            [
                "db-sensor-insert"
            ]
        ]
    },
